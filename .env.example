# ============================================================================
# GIROPie Website Environment Configuration (.env.example)
# Copy values into Vercel Project Settings -> Environment Variables
# ============================================================================

# Canonical public URL (no trailing slash).
# Leave unset on staging to auto-use VERCEL_PROJECT_PRODUCTION_URL;
# set to https://www.giropie.com when switching production DNS.
VITE_SITE_URL=https://www.giropie.com

# Google Analytics 4 Measurement ID (Tech Fix #10)
VITE_GA_MEASUREMENT_ID=

# Contact Form Delivery — Monitored Mailbox & CRM Routing (Tech Fix #9)
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=info@giropie.com
CONTACT_FROM_EMAIL="GIROPie Website <notifications@giropie.com>"
CONTACT_EMAIL_WEBHOOK_URL=
CRM_WEBHOOK_URL=
CRM_WEBHOOK_AUTH_HEADER=

# Optional Cloudflare Turnstile Spam Protection
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

