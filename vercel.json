{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/price",
      "destination": "/pricing",
      "statusCode": 301
    },
    {
      "source": "/faqs",
      "destination": "/faq",
      "statusCode": 301
    },
    {
      "source": "/jobs",
      "destination": "/careers",
      "statusCode": 301
    },
    {
      "source": "/trade-finance-solutions",
      "destination": "/features",
      "statusCode": 301
    },
    {
      "source": "/gofundz",
      "destination": "/features",
      "statusCode": 301
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "statusCode": 301
    },
    {
      "source": "/home",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/about-us",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "statusCode": 301
    },
    {
      "source": "/post/:slug",
      "destination": "/blog/:slug",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/spa-fallback.html"
    }
  ]
}
